# Anti-abuse: channel where alerts about recently-created (possible alt) accounts are posted (tranche E)
ALT_ACCOUNT_ALERT_CHANNEL_ID=

# Suggestions IA -> Claude Code : salon où !suggest est utilisé, salon de
# validation à deux (accepter/refuser), clé API DeepSeek pour l'entretien de
# clarification.
SUGGESTION_CHANNEL_ID=
SUGGESTION_VALIDATION_CHANNEL_ID=
DEEPSEEK_API_KEY=

# Tour RPG : catégorie dans laquelle les salons tower-of-<joueur> sont créés
# quand un joueur clique sur "Entrer" dans le panneau de la Tour.
TOUR_CATEGORY_ID=
