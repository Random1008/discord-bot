DISCORD_TOKEN=your-bot-token-here
DATABASE_URL=postgresql+asyncpg://colombina:colombina@localhost:5432/colombina
REDIS_URL=redis://localhost:6379/0
COMMAND_PREFIX=!
SQL_ECHO=false
LOG_LEVEL=INFO

